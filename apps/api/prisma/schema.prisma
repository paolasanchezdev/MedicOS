// ======================================================
// MedicOS MVP - Esquema Oficial de Base de Datos
// Prisma ORM 7.x / 8.x Compatible
// Motor de Base de Datos: PostgreSQL
// Arquitectura: Offline First (Transactional Outbox Pattern)
// Entorno: Servidor Central Cloud / Raspberry Pi
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS GLOBALES DE CONTROL Y DOMINIO CLÍNICO
// ======================================================

enum Role {
  ADMIN
  DOCTOR
  BRIGADISTA
  AUTHORITY
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QueuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DeviceStatus {
  ACTIVE
  OFFLINE
  BLOCKED
  RETIRED
}

enum BrigadeStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ConsultationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DiagnosisStatus {
  ACTIVE
  HISTORICAL
  RESOLVED
}

enum AppointmentStatus {
  REQUESTED
  PENDING
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentModality {
  PRESENTIAL
  TELEMEDICINE
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IntakeStatus {
  PENDING
  TAKEN
  MISSED
}

enum LaboratoryStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReferenceStatus {
  WITHIN_RANGE
  ABOVE_RANGE
  BELOW_RANGE
  UNEVALUATED
}

enum ImagingType {
  XRAY
  ULTRASOUND
  TOMOGRAPHY
  RESONANCE
  MAMMOGRAPHY
  DENSITOMETRY
  OTHER
}

enum ImagingStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum LifestyleHabitType {
  WATER
  ACTIVITY
  SLEEP
  NUTRITION
  TOBACCO
  ALCOHOL
  MINDFULNESS
}

enum ActivityIntensity {
  LIGHT
  MODERATE
  INTENSE
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  UNKNOWN
}

enum SessionStatus {
  STARTED
  ENDED
}

enum EmergencyRelationship {
  MADRE
  PADRE
  HIJO_A
  HERMANO_A
  CONYUGE
  PAREJA
  ABUELO_A
  TUTOR_A
  FAMILIAR
  AMIGO_A
  OTRO
}

// ======================================================
// ENUMS DE CONSTANCIAS MÉDICAS Y DOCUMENTOS OFICIALES
// ======================================================

enum CertificateType {
  MEDICAL_ATTENTION
  CONSULTATION
  PRENATAL_CONTROL
  OTHER
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

// ======================================================
// ENUMS DE ESTABLECIMIENTOS (RED DE REFERENCIA)
// ======================================================

enum EstablishmentType {
  HOSPITAL
  CLINIC
  HEALTH_CENTER
}

enum EstablishmentLevel {
  SPECIALIZED
  REGIONAL
  DEPARTMENTAL
  BASIC
}

enum EstablishmentOperator {
  MINSAL
  ISSS
  FAES
  PRIVATE
  OTHER
}

enum EstablishmentStatus {
  OPERATIONAL
  MAINTENANCE
  INACTIVE
}

// ======================================================
// ENUMS DE RECURSOS, INVENTARIO Y DOTACIÓN
// ======================================================

enum ResourceCategory {
  MEDICINE
  CLINICAL_SUPPLY
  OTHER
}

enum StockStatus {
  AVAILABLE
  QUARANTINE
  DEPLETED
  EXPIRED
}

enum EquipmentStatus {
  OPERATIONAL
  IN_MAINTENANCE
  DAMAGED
  DECOMMISSIONED
}

enum ItemCondition {
  OPTIMAL
  GOOD
  DAMAGED
  UNUSABLE
}

// ======================================================
// RED DE REFERENCIA Y DERIVACIÓN (ESTABLECIMIENTOS)
// ======================================================

model Establishment {
  id              String                @id @default(uuid())
  code            String                @unique
  name            String
  type            EstablishmentType     @default(HOSPITAL)
  level           EstablishmentLevel    @default(DEPARTMENTAL)
  operator        EstablishmentOperator @default(MINSAL)
  department      String
  municipality    String
  address         String
  latitude        Float?
  longitude       Float?
  phone           String?
  emergencyPhone  String?
  hasEmergency    Boolean               @default(false)
  specialties     String[]              @default([])
  totalBeds       Int                   @default(0)
  availableBeds   Int                   @default(0)
  status          EstablishmentStatus   @default(OPERATIONAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  appointments        Appointment[]
  medicalCertificates MedicalCertificate[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([type])
  @@index([operator])
  @@index([status])
  @@index([hasEmergency])
  @@index([department, municipality])
  @@index([syncStatus])
  @@index([lastModified])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

// ======================================================
// HARDWARE Y DISPOSITIVOS TECNOLÓGICOS
// ======================================================

model Device {
  id              String       @id @default(uuid())
  name            String
  serialNumber    String       @unique
  operatingSystem String
  appVersion      String
  publicKey       String?
  location        String?
  lastSyncAt      DateTime?
  status          DeviceStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  auditLogs           AuditLog[]
  syncQueues          SyncQueue[]
  brigadeAssignments BrigadeDevice[]

  @@index([status])
  @@index([serialNumber])
}

// ======================================================
// COLA DE SINCRONIZACIÓN (TRANSACTIONAL OUTBOX PATTERN)
// ======================================================

model SyncQueue {
  id        String        @id @default(uuid())
  deviceId  String?
  entity    String
  entityId  String
  operation SyncOperation
  payload   Json
  priority  QueuePriority @default(MEDIUM)
  status    QueueStatus   @default(PENDING)

  retryCount   Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  syncedAt     DateTime?

  // Relaciones
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([entity, entityId])
  @@index([deviceId])
}

// ======================================================
// GESTIÓN DE ACCESO E IDENTIDAD (IAM)
// ======================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(BRIGADISTA)
  status       UserStatus @default(ACTIVE)
  firstName    String
  lastName     String
  specialty    String?
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  // Relaciones
  brigadesLed         Brigade[]            @relation("BrigadeLeader")
  brigadesAssigned    BrigadeMember[]
  consultations       Consultation[]       @relation("DoctorConsultations")
  appointments        Appointment[]        @relation("DoctorAppointments")
  prescriptions       Prescription[]       @relation("DoctorPrescriptions")
  workSessions        WorkSession[]        @relation("BrigadistaSessions")
  auditLogs           AuditLog[]
  patient             Patient?
  medicalCertificates MedicalCertificate[]

  @@index([role])
  @@index([status])
  @@index([lastName, firstName])
}

// ======================================================
// CONTROLES DE EXPEDICIONES Y BRIGADAS MÉDICAS
// ======================================================

model Brigade {
  id           String        @id @default(uuid())
  name         String
  department   String
  municipality String
  latitude     Float?
  longitude    Float?
  status       BrigadeStatus @default(PLANNED)
  startDate    DateTime
  endDate      DateTime?
  leaderId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  // Relaciones Operativas
  leader        User?           @relation("BrigadeLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members       BrigadeMember[]
  consultations Consultation[]
  prescriptions Prescription[]
  workSessions  WorkSession[]   @relation("BrigadeSessions")

  // Dotación de Recursos en Campo
  supplyItems    BrigadeSupplyItem[]
  equipmentItems BrigadeEquipmentItem[]
  devices        BrigadeDevice[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

model BrigadeMember {
  id        String   @id @default(uuid())
  userId    String
  brigadeId String
  joinedAt  DateTime @default(now())

  // Relaciones
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  brigade Brigade @relation(fields: [brigadeId], references: [id], onDelete: Cascade)

  @@unique([userId, brigadeId])
}

// ======================================================
// RECURSOS: CATÁLOGO MAESTRO (MEDICAMENTOS E INSUMOS)
// ======================================================

model Resource {
  id           String           @id @default(uuid())
  code         String           @unique
  name         String
  genericName  String?
  category     ResourceCategory @default(MEDICINE)
  unit         String
  isConsumable Boolean          @default(true)
  minThreshold Int              @default(10)
  isActive     Boolean          @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  stocks ResourceStock[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([isConsumable])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// RECURSOS: STOCK FÍSICO Y LOTES (BODEGA CENTRAL)
// ======================================================

model ResourceStock {
  id                String      @id @default(uuid())
  resourceId        String
  lotNumber         String
  expirationDate    DateTime
  quantityAvailable Int
  quantityReserved  Int         @default(0)
  status            StockStatus @default(AVAILABLE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  resource        Resource            @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  brigadeSupplies BrigadeSupplyItem[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@unique([resourceId, lotNumber])
  @@index([resourceId])
  @@index([expirationDate])
  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// RECURSOS: EQUIPAMIENTO E INSTRUMENTAL MÉDICO
// ======================================================

model MedicalEquipment {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  model        String?
  serialNumber String?         @unique
  status       EquipmentStatus @default(OPERATIONAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  brigadeAssignments BrigadeEquipmentItem[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// DOTACIÓN: ASIGNACIÓN DE CONSUMIBLES POR LOTE A BRIGADA
// ======================================================

model BrigadeSupplyItem {
  id                String  @id @default(uuid())
  brigadeId         String
  stockId           String
  quantitySupplied  Int
  quantityDispensed Int     @default(0)
  quantityReturned  Int     @default(0)
  quantityWasted    Int     @default(0)
  notes             String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  brigade Brigade       @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  stock   ResourceStock @relation(fields: [stockId], references: [id], onDelete: Restrict)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([brigadeId])
  @@index([stockId])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// DOTACIÓN: ASIGNACIÓN DE INSTRUMENTAL MÉDICO A BRIGADA
// ======================================================

model BrigadeEquipmentItem {
  id           String         @id @default(uuid())
  brigadeId    String
  equipmentId  String
  conditionOut ItemCondition  @default(OPTIMAL)
  conditionIn  ItemCondition?
  dispatchedAt DateTime       @default(now())
  returnedAt   DateTime?
  notes        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  brigade   Brigade          @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  equipment MedicalEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([brigadeId])
  @@index([equipmentId])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// DOTACIÓN: ASIGNACIÓN DE DISPOSITIVOS HARDWARE A BRIGADA
// ======================================================

model BrigadeDevice {
  id            String    @id @default(uuid())
  brigadeId     String
  deviceId      String
  assignedAt    DateTime  @default(now())
  returnedAt    DateTime?
  roleInBrigade String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  brigade Brigade @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([brigadeId])
  @@index([deviceId])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// CORE CLÍNICO: PACIENTES Y EXPEDIENTES
// ======================================================

model Patient {
  id                     String      @id @default(uuid())
  userId                 String?     @unique
  user                   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName              String
  lastName               String
  dateOfBirth            DateTime
  dui                    String?     @unique
  sex                    Sex         @default(OTHER)
  phone                  String?
  address                String
  emergencyName          String?
  emergencyPhone         String?
  emergencyRelation      String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime?
  syncStatus             SyncStatus  @default(SYNCED)
  version                Int         @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime    @default(now())

  clinicalRecord        ClinicalRecord?
  consultations         Consultation[]
  appointments          Appointment[]
  prescriptions         Prescription[]
  medicationIntakes     MedicationIntake[]
  laboratoryStudies     LaboratoryStudy[]
  medicalImagingStudies MedicalImagingStudy[]
  lifestyleHabitLogs    LifestyleHabitLog[]
  lifestyleActivities   LifestyleActivity[]
  lifestyleGoals        LifestyleGoal[]
  vitalSigns            VitalSigns[]
  diagnoses             Diagnosis[]
  medicalCertificates   MedicalCertificate[]
  emergencyContacts     EmergencyContact[]

  @@index([dui])
  @@index([userId])
}

// ======================================================
// CONTACTOS DE EMERGENCIA DEL PACIENTE
// ======================================================

model EmergencyContact {
  id             String                @id @default(uuid())
  patientId      String
  firstName      String
  lastName       String
  relationship   EmergencyRelationship @default(FAMILIAR)
  customRelation String?
  primaryPhone   String
  secondaryPhone String?
  email          String?
  isPrimary      Boolean               @default(false)
  isActive       Boolean               @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("WEB_PORTAL")
  lastModifiedByDeviceId String     @default("WEB_PORTAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId])
  @@index([isPrimary])
  @@index([isActive])
  @@index([syncStatus])
  @@index([lastModified])
}

model ClinicalRecord {
  id              String    @id @default(uuid())
  patientId       String    @unique
  bloodType       BloodType @default(UNKNOWN)
  familyHistory   String?
  surgicalHistory String?
  observations    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relaciones
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultations Consultation[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([syncStatus])
  @@index([lastModified])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

// ======================================================
// GESTIÓN DE CITAS PROGRAMADAS (APPOINTMENTS)
// ======================================================

model Appointment {
  id              String              @id @default(uuid())
  patientId       String
  doctorId        String
  establishmentId String?
  appointmentDate DateTime
  durationMinutes Int                 @default(30)
  reason          String
  status          AppointmentStatus   @default(CONFIRMED)
  modality        AppointmentModality @default(PRESENTIAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User           @relation("DoctorAppointments", fields: [doctorId], references: [id])
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  consultations Consultation[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([doctorId, appointmentDate])
  @@index([patientId])
  @@index([establishmentId])
  @@index([status])
}

// ======================================================
// ENCUENTROS CLÍNICOS Y SIGNOS VITALES
// ======================================================

model Consultation {
  id               String             @id @default(uuid())
  patientId        String
  doctorId         String
  clinicalRecordId String
  brigadeId        String?
  appointmentId    String?
  status           ConsultationStatus @default(DRAFT)

  // Metodología SOAP
  chiefComplaint String
  physicalExam   String
  diagnosisCode  String?
  diagnosisDesc  String
  treatmentPlan  String

  // Control de tiempos clínicos y administrativos
  consultationDate DateTime  @default(now())
  followUpDate     DateTime?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relaciones
  patient             Patient              @relation(fields: [patientId], references: [id])
  doctor              User                 @relation("DoctorConsultations", fields: [doctorId], references: [id])
  clinicalRecord      ClinicalRecord       @relation(fields: [clinicalRecordId], references: [id])
  brigade             Brigade?             @relation(fields: [brigadeId], references: [id])
  appointment         Appointment?         @relation(fields: [appointmentId], references: [id])
  prescriptions       Prescription[]
  workSessionId       String?
  workSession         WorkSession?         @relation(fields: [workSessionId], references: [id])
  vitalSigns          VitalSigns[]
  diagnoses           Diagnosis[]
  medicalCertificates MedicalCertificate[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([brigadeId])
  @@index([appointmentId])
  @@index([workSessionId])
  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

// ======================================================
// EXPEDIENTE CLÍNICO: DIAGNÓSTICOS FORMALES
// ======================================================

model Diagnosis {
  id             String          @id @default(uuid())
  patientId      String
  consultationId String?
  code           String?
  description    String
  status         DiagnosisStatus @default(ACTIVE)
  notes          String?
  diagnosedAt    DateTime        @default(now())
  resolvedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId])
  @@index([consultationId])
  @@index([status])
  @@index([code])
  @@index([syncStatus])
  @@index([diagnosedAt])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

model VitalSigns {
  id             String    @id @default(uuid())
  patientId      String
  consultationId String?
  temperature    Float
  heartRate      Int
  oxygenSat      Int
  systolic       Int
  diastolic      Int
  weight         Float?
  height         Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relaciones
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId])
  @@index([consultationId])
  @@index([syncStatus])
  @@index([createdAt])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

// ======================================================
// PRESCRIPCIONES CLÍNICAS Y FARMACOTERAPIA
// ======================================================

model Prescription {
  id             String             @id @default(uuid())
  code           String             @unique // Ej. RX-2026-0001
  patientId      String
  doctorId       String
  consultationId String?
  brigadeId      String?
  status         PrescriptionStatus @default(ACTIVE)
  notes          String?
  issuedAt       DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  // Relaciones
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       User               @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  consultation Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  brigade      Brigade?           @relation(fields: [brigadeId], references: [id], onDelete: SetNull)
  items        PrescriptionItem[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([issuedAt])
  @@index([syncStatus])
  @@index([lastModified])
}

model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String
  medicine       String   // Ej. Amoxicilina
  dosage         String   // Ej. 500 mg
  route          String   @default("ORAL")
  frequency      String   // Ej. Cada 8 horas
  duration       String   // Ej. Por 7 días
  instructions   String?  // Ej. Tomar después de las comidas
  startDate      DateTime @default(now())
  endDate        DateTime // Calculada al prescribir

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  prescription Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  intakes      MedicationIntake[]

  @@index([prescriptionId])
  @@index([endDate])
}

// ======================================================
// SEGUIMIENTO DE TOMAS Y RECORDATORIOS
// ======================================================

model MedicationIntake {
  id                 String       @id @default(uuid())
  patientId          String
  prescriptionItemId String
  scheduledFor       DateTime
  takenAt            DateTime?
  status             IntakeStatus @default(PENDING)
  notes              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@unique([prescriptionItemId, scheduledFor])
  @@index([patientId, scheduledFor])
  @@index([status])
  @@index([scheduledFor])
  @@index([syncStatus])
}

// ======================================================
// ESTUDIOS Y ANÁLISIS DE LABORATORIO CLÍNICO
// ======================================================

model LaboratoryStudy {
  id                String           @id @default(uuid())
  code              String           @unique // Ej. LAB-2026-00001
  patientId         String
  doctorId          String?
  consultationId    String?
  brigadeId         String?
  name              String           // Ej. Hemograma Completo, Examen General de Orina
  category          String?          // Ej. Hematología, Uroanálisis, Química Sanguínea
  establishmentName String           // Ej. Laboratorio Central, Unidad de Salud
  status            LaboratoryStatus @default(COMPLETED)
  performedAt       DateTime         @default(now())
  observations      String?
  documentUrl       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient  Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  analytes LaboratoryAnalyte[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId, performedAt])
  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
}

model LaboratoryAnalyte {
  id                   String          @id @default(uuid())
  studyId              String
  name                 String          // Ej. Hemoglobina, Glucosa, Leucocitos
  value                String          // Ej. 13.8, 85, Negativo
  unit                 String          // Ej. g/dL, mg/dL, /µL
  referenceMin         Float?          // Ej. 12.0
  referenceMax         Float?          // Ej. 16.0
  referenceText        String?         // Ej. 12.0 - 16.0 g/dL
  interpretationStatus ReferenceStatus @default(WITHIN_RANGE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  study LaboratoryStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}

// ======================================================
// ESTUDIOS DE IMAGEN MÉDICA Y RADIODIAGNÓSTICO
// ======================================================

model MedicalImagingStudy {
  id                String        @id @default(uuid())
  code              String        @unique // Ej. IMG-2026-00001
  patientId         String
  doctorId          String?
  consultationId    String?
  brigadeId         String?
  name              String        // Ej. Radiografía de tórax PA
  type              ImagingType   @default(XRAY)
  bodyRegion        String        // Ej. Tórax, Abdomen, Rodilla derecha
  establishmentName String        // Ej. Hospital Nacional Rosales, Unidad de Salud
  status            ImagingStatus @default(COMPLETED)
  performedAt       DateTime      @default(now())
  findings          String?       // Hallazgos descriptivos
  conclusion        String?       // Conclusión diagnóstica
  documentUrl       String?       // Informe formal en PDF
  imageUrl          String?       // Imagen/captura de estudio

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId, performedAt])
  @@index([type])
  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// ESTILO DE VIDA, HÁBITOS DIARIOS Y AUTOCUIDADO
// ======================================================

model LifestyleHabitLog {
  id         String             @id @default(uuid())
  patientId  String
  habitType  LifestyleHabitType
  loggedDate DateTime           @db.Date
  value      Float              // Ej: 8 vasos, 7.5 hrs sueño, 1 meta cumplida
  unit       String             // Ej: vasos, horas, puntos
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@unique([patientId, habitType, loggedDate])
  @@index([patientId, loggedDate])
  @@index([habitType])
  @@index([syncStatus])
}

model LifestyleActivity {
  id              String            @id @default(uuid())
  patientId       String
  activityName    String            // Caminata, Bicicleta, Ejercicio en casa, etc.
  durationMinutes Int               // Minutos dedicados
  intensity       ActivityIntensity @default(MODERATE)
  performedAt     DateTime          @default(now())
  notes           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId, performedAt])
  @@index([syncStatus])
}

model LifestyleGoal {
  id         String             @id @default(uuid())
  patientId  String
  title      String             // Ej: Actividad física 4 días por semana
  habitType  LifestyleHabitType @default(ACTIVITY)
  targetDays Int                // Ej: 4 días
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  status     GoalStatus         @default(IN_PROGRESS)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId, status])
  @@index([syncStatus])
}

// ======================================================
// JORNADAS DE TRABAJO - BRIGADISTAS (WORKSESSION)
// ======================================================

model WorkSession {
  id           String        @id @default(uuid())
  brigadistaId String
  brigadeId    String
  status       SessionStatus @default(STARTED)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?

  // Relaciones
  brigadista    User           @relation("BrigadistaSessions", fields: [brigadistaId], references: [id])
  brigade       Brigade        @relation("BrigadeSessions", fields: [brigadeId], references: [id])
  consultations Consultation[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([brigadistaId, status])
  @@index([brigadeId])
  @@index([syncStatus])
}

// ======================================================
// CONSTANCIAS MÉDICAS Y DOCUMENTOS OFICIALES
// ======================================================

model MedicalCertificate {
  id              String            @id @default(uuid())
  code            String            @unique // Ej. CM-2026-000124
  type            CertificateType   @default(MEDICAL_ATTENTION)
  patientId       String
  doctorId        String?
  establishmentId String?
  consultationId  String?
  issuedAt        DateTime          @default(now())
  observations    String?
  qrHash          String            @unique
  status          CertificateStatus @default(ACTIVE)
  documentUrl     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User?          @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  consultation  Consultation?  @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId, issuedAt])
  @@index([code])
  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// AUDITORÍA Y SEGURIDAD OPERATIVA
// ======================================================

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  deviceId      String?
  action        String
  entity        String
  entityId      String
  changedFields Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  // Relaciones
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}