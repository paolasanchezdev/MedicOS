// ======================================================
// MedicOS MVP - Esquema Oficial de Base de Datos
// Prisma ORM 7.x / 8.x Compatible
// Motor de Base de Datos: PostgreSQL
// Arquitectura: Offline First (Transactional Outbox Pattern)
// Entorno: Servidor Central Cloud / Raspberry Pi
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS GLOBALES DE CONTROL Y DOMINIO CLÍNICO
// ======================================================

enum Role {
  ADMIN
  DOCTOR
  BRIGADISTA
  AUTHORITY
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QueuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DeviceStatus {
  ACTIVE
  OFFLINE
  BLOCKED
  RETIRED
}

enum BrigadeStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ConsultationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  UNKNOWN
}

enum SessionStatus {
  STARTED
  ENDED
}

// ======================================================
// ENUMS DE ESTABLECIMIENTOS (RED DE REFERENCIA)
// ======================================================

enum EstablishmentType {
  HOSPITAL
  CLINIC
  HEALTH_CENTER
}

enum EstablishmentLevel {
  SPECIALIZED
  REGIONAL
  DEPARTMENTAL
  BASIC
}

enum EstablishmentOperator {
  MINSAL
  ISSS
  FAES
  PRIVATE
  OTHER
}

enum EstablishmentStatus {
  OPERATIONAL
  MAINTENANCE
  INACTIVE
}

// ======================================================
// ENUMS DE RECURSOS, INVENTARIO Y DOTACIÓN
// ======================================================

enum ResourceCategory {
  MEDICINE
  CLINICAL_SUPPLY
  OTHER
}

enum StockStatus {
  AVAILABLE
  QUARANTINE
  DEPLETED
  EXPIRED
}

enum EquipmentStatus {
  OPERATIONAL
  IN_MAINTENANCE
  DAMAGED
  DECOMMISSIONED
}

enum ItemCondition {
  OPTIMAL
  GOOD
  DAMAGED
  UNUSABLE
}

// ======================================================
// RED DE REFERENCIA Y DERIVACIÓN (ESTABLECIMIENTOS)
// ======================================================

model Establishment {
  id              String                @id @default(uuid())
  code            String                @unique
  name            String
  type            EstablishmentType     @default(HOSPITAL)
  level           EstablishmentLevel    @default(DEPARTMENTAL)
  operator        EstablishmentOperator @default(MINSAL)
  department      String
  municipality    String
  address         String
  latitude        Float?
  longitude       Float?
  phone           String?
  emergencyPhone String?
  hasEmergency    Boolean               @default(false)
  specialties     String[]              @default([])
  totalBeds       Int                   @default(0)
  availableBeds   Int                   @default(0)
  status          EstablishmentStatus   @default(OPERATIONAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([type])
  @@index([operator])
  @@index([status])
  @@index([hasEmergency])
  @@index([department, municipality])
  @@index([syncStatus])
  @@index([lastModified])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

// ======================================================
// HARDWARE Y DISPOSITIVOS TECNOLÓGICOS
// ======================================================

model Device {
  id              String       @id @default(uuid())
  name            String
  serialNumber    String       @unique
  operatingSystem String
  appVersion      String
  publicKey       String?
  location        String?
  lastSyncAt      DateTime?
  status          DeviceStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  auditLogs           AuditLog[]
  syncQueues          SyncQueue[]
  brigadeAssignments BrigadeDevice[]

  @@index([status])
  @@index([serialNumber])
}

// ======================================================
// COLA DE SINCRONIZACIÓN (TRANSACTIONAL OUTBOX PATTERN)
// ======================================================

model SyncQueue {
  id        String        @id @default(uuid())
  deviceId  String?
  entity    String
  entityId  String
  operation SyncOperation
  payload   Json
  priority  QueuePriority @default(MEDIUM)
  status    QueueStatus   @default(PENDING)

  retryCount   Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  syncedAt     DateTime?

  // Relaciones
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([entity, entityId])
  @@index([deviceId])
}

// ======================================================
// GESTIÓN DE ACCESO E IDENTIDAD (IAM)
// ======================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(BRIGADISTA)
  status       UserStatus @default(ACTIVE)
  firstName    String
  lastName     String
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  // Relaciones
  brigadesLed      Brigade[]       @relation("BrigadeLeader")
  brigadesAssigned BrigadeMember[]
  consultations    Consultation[]  @relation("DoctorConsultations")
  appointments     Appointment[]   @relation("DoctorAppointments")
  workSessions     WorkSession[]   @relation("BrigadistaSessions")
  auditLogs        AuditLog[]
  patient          Patient?

  @@index([role])
  @@index([status])
  @@index([lastName, firstName])
}

// ======================================================
// CONTROLES DE EXPEDICIONES Y BRIGADAS MÉDICAS
// ======================================================

model Brigade {
  id           String        @id @default(uuid())
  name         String
  department   String
  municipality String
  latitude     Float?
  longitude    Float?
  status       BrigadeStatus @default(PLANNED)
  startDate    DateTime
  endDate      DateTime?
  leaderId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  // Relaciones Operativas
  leader        User?                 @relation("BrigadeLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members       BrigadeMember[]
  consultations Consultation[]
  workSessions  WorkSession[]         @relation("BrigadeSessions")

  // Dotación de Recursos en Campo
  supplyItems    BrigadeSupplyItem[]
  equipmentItems BrigadeEquipmentItem[]
  devices        BrigadeDevice[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

model BrigadeMember {
  id        String   @id @default(uuid())
  userId    String
  brigadeId String
  joinedAt  DateTime @default(now())

  // Relaciones
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  brigade Brigade @relation(fields: [brigadeId], references: [id], onDelete: Cascade)

  @@unique([userId, brigadeId])
}

// ======================================================
// RECURSOS: CATÁLOGO MAESTRO (MEDICAMENTOS E INSUMOS)
// ======================================================

model Resource {
  id           String           @id @default(uuid())
  code         String           @unique
  name         String
  genericName  String?
  category     ResourceCategory @default(MEDICINE)
  unit         String
  isConsumable Boolean          @default(true)
  minThreshold Int              @default(10)
  isActive     Boolean          @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  stocks ResourceStock[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([isConsumable])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// RECURSOS: STOCK FÍSICO Y LOTES (BODEGA CENTRAL)
// ======================================================

model ResourceStock {
  id                String      @id @default(uuid())
  resourceId        String
  lotNumber         String
  expirationDate    DateTime
  quantityAvailable Int
  quantityReserved  Int         @default(0)
  status            StockStatus @default(AVAILABLE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  resource        Resource            @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  brigadeSupplies BrigadeSupplyItem[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@unique([resourceId, lotNumber])
  @@index([resourceId])
  @@index([expirationDate])
  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// RECURSOS: EQUIPAMIENTO E INSTRUMENTAL MÉDICO
// ======================================================

model MedicalEquipment {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  model        String?
  serialNumber String?         @unique
  status       EquipmentStatus @default(OPERATIONAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  brigadeAssignments BrigadeEquipmentItem[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// DOTACIÓN: ASIGNACIÓN DE CONSUMIBLES POR LOTE A BRIGADA
// ======================================================

model BrigadeSupplyItem {
  id                String  @id @default(uuid())
  brigadeId         String
  stockId           String
  quantitySupplied  Int
  quantityDispensed Int     @default(0)
  quantityReturned  Int     @default(0)
  quantityWasted    Int     @default(0)
  notes             String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  brigade Brigade       @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  stock   ResourceStock @relation(fields: [stockId], references: [id], onDelete: Restrict)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([brigadeId])
  @@index([stockId])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// DOTACIÓN: ASIGNACIÓN DE INSTRUMENTAL MÉDICO A BRIGADA
// ======================================================

model BrigadeEquipmentItem {
  id           String         @id @default(uuid())
  brigadeId    String
  equipmentId  String
  conditionOut ItemCondition  @default(OPTIMAL)
  conditionIn  ItemCondition?
  dispatchedAt DateTime       @default(now())
  returnedAt   DateTime?
  notes        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  brigade   Brigade          @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  equipment MedicalEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([brigadeId])
  @@index([equipmentId])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// DOTACIÓN: ASIGNACIÓN DE DISPOSITIVOS HARDWARE A BRIGADA
// ======================================================

model BrigadeDevice {
  id            String    @id @default(uuid())
  brigadeId     String
  deviceId      String
  assignedAt    DateTime  @default(now())
  returnedAt    DateTime?
  roleInBrigade String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  brigade Brigade @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([brigadeId])
  @@index([deviceId])
  @@index([syncStatus])
  @@index([lastModified])
}

// ======================================================
// CORE CLÍNICO: PACIENTES Y EXPEDIENTES
// ======================================================

model Patient {
  id                     String     @id @default(uuid())
  userId                 String?    @unique
  user                   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName              String
  lastName               String
  dateOfBirth            DateTime
  dui                    String?    @unique
  sex                    Sex        @default(OTHER)
  phone                  String?
  address                String
  emergencyName          String?
  emergencyPhone         String?
  emergencyRelation      String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  deletedAt              DateTime?
  syncStatus             SyncStatus @default(SYNCED)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now())

  clinicalRecord ClinicalRecord?
  consultations  Consultation[]
  appointments   Appointment[]
  vitalSigns     VitalSigns[]

  @@index([dui])
  @@index([userId])
}

model ClinicalRecord {
  id              String    @id @default(uuid())
  patientId       String    @unique
  bloodType       BloodType @default(UNKNOWN)
  familyHistory   String?
  surgicalHistory String?
  observations    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relaciones
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultations Consultation[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([syncStatus])
  @@index([lastModified])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

// ======================================================
// GESTIÓN DE CITAS PROGRAMADAS (APPOINTMENTS)
// ======================================================

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  durationMinutes Int               @default(30)
  reason          String
  status          AppointmentStatus @default(CONFIRMED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User           @relation("DoctorAppointments", fields: [doctorId], references: [id])
  consultations Consultation[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String     @default("SERVER_CENTRAL")
  lastModifiedByDeviceId String     @default("SERVER_CENTRAL")
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([doctorId, appointmentDate])
  @@index([patientId])
  @@index([status])
}

// ======================================================
// ENCUENTROS CLÍNICOS Y SIGNOS VITALES
// ======================================================

model Consultation {
  id               String             @id @default(uuid())
  patientId        String
  doctorId         String
  clinicalRecordId String
  brigadeId        String?            // Opcional para citas fuera de brigada
  appointmentId    String?            // Opcional si proviene de cita agendada
  status           ConsultationStatus @default(DRAFT)

  // Metodología SOAP
  chiefComplaint String
  physicalExam   String
  diagnosisCode  String?
  diagnosisDesc  String
  treatmentPlan  String

  // Control de tiempos clínicos y administrativos
  consultationDate DateTime  @default(now())
  followUpDate     DateTime?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relaciones
  patient        Patient         @relation(fields: [patientId], references: [id])
  doctor         User            @relation("DoctorConsultations", fields: [doctorId], references: [id])
  clinicalRecord ClinicalRecord  @relation(fields: [clinicalRecordId], references: [id])
  brigade        Brigade?        @relation(fields: [brigadeId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  workSessionId  String?
  workSession    WorkSession?    @relation(fields: [workSessionId], references: [id])
  vitalSigns     VitalSigns[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([brigadeId])
  @@index([appointmentId])
  @@index([workSessionId])
  @@index([status])
  @@index([syncStatus])
  @@index([lastModified])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

model VitalSigns {
  id             String        @id @default(uuid())
  patientId      String
  consultationId String?
  temperature    Float
  heartRate      Int
  oxygenSat      Int
  systolic       Int
  diastolic      Int
  weight         Float?
  height         Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Relaciones
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([patientId])
  @@index([consultationId])
  @@index([syncStatus])
  @@index([createdAt])
  @@index([originDeviceId])
  @@index([lastModifiedByDeviceId])
}

// ======================================================
// JORNADAS DE TRABAJO - BRIGADISTAS (WORKSESSION)
// ======================================================

model WorkSession {
  id           String        @id @default(uuid())
  brigadistaId String
  brigadeId    String
  status       SessionStatus @default(STARTED)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?

  // Relaciones
  brigadista    User          @relation("BrigadistaSessions", fields: [brigadistaId], references: [id])
  brigade       Brigade       @relation("BrigadeSessions", fields: [brigadeId], references: [id])
  consultations Consultation[]

  // Metadatos Obligatorios Offline First
  syncStatus             SyncStatus @default(PENDING)
  version                Int        @default(1)
  originDeviceId         String
  lastModifiedByDeviceId String
  lastModified           DateTime   @default(now()) @updatedAt

  @@index([brigadistaId, status])
  @@index([brigadeId])
  @@index([syncStatus])
}

// ======================================================
// AUDITORÍA Y SEGURIDAD OPERATIVA
// ======================================================

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  deviceId      String?
  action        String
  entity        String
  entityId      String
  changedFields Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  // Relaciones
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}