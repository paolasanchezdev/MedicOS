# =========================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - MedicOS Monorepo
# Copia este archivo a `.env` en la raíz (o en apps/api y apps/web)
# =========================================================================

# -------------------------------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR BACKEND (apps/api)
# -------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Seguridad JWT (Sustituir por una cadena aleatoria compleja en producción)
JWT_SECRET=medicos_jwt_secret_dev_2026_key_change_me_in_prod

# Base de Datos (Prisma - MySQL / MariaDB)
DATABASE_URL="mysql://root:password@localhost:3306/medicos_db"

# Anti-Bot (Cloudflare Turnstile - Clave de pruebas de desarrollo)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -------------------------------------------------------------------------
# CONFIGURACIÓN DEL CLIENTE WEB (apps/web)
# Importante: Las variables de Vite deben iniciar con el prefijo VITE_
# -------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api

# Anti-Bot Cliente (Cloudflare Turnstile - Clave de sitio de pruebas)
VITE_TURNSTILE_SITE_KEY=1x0000000000000000000000000000000AA