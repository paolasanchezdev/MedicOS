{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "JWT_SECRET",
    "PORT",
    "NODE_ENV"
  ],
  "globalDependencies": [
    ".env"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}